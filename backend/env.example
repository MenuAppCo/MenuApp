DATABASE_URL=
NODE_ENV=
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AWS S3 (almacenamiento de imagenes)
#
# El codigo NO tiene valores por defecto: si estas variables faltan, las
# subidas fallan. El nombre del bucket se lee de S3_IMAGES_BUCKET_NAME
# (src/config/s3.js), que es la misma variable que inyecta Terraform en las
# Lambda (iac/backend/lambda/admin_api_lambda.tf).
#
# En produccion las credenciales salen del rol IAM de la Lambda, asi que
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY solo hacen falta en local.
#
# Cuidado: el valor de abajo apunta al bucket de PRODUCCION. Si desarrollas
# en local con el, las imagenes que subas van a produccion.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_IMAGES_BUCKET_NAME=production-menapp-images
